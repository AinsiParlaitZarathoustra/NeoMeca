{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeoMeca",
  "version": "26.11.23",
  "identifier": "fr.neomeca.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NeoMeca",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "shortDescription": "Pointage vidéo et analyse mécanique pour la physique-chimie",
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "minimumWebview2Version": "100.0.1185.29",
      "nsis": {
        "languages": ["French", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "version": "26.11.23",
        "language": "fr-FR"
      }
    },
    "linux": {},
    "resources": {
      "bin/": "bin/",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
